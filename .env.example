# Kimi-Free-API 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 基本配置
NODE_ENV=production
PORT=8000

# 认证相关
AUTH_SECRET_KEY=your-secret-key-here
AUTH_TOKEN_EXPIRES=3600

# 请求限制
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Kimi API 配置
# 如果需要特殊的API配置，可以在这里添加

# 其他自定义配置